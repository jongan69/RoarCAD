# Server-only JLCPCB OpenAPI credentials. Never expose these through VITE_* variables.
JLCPCB_APP_ID=
JLCPCB_ACCESS_KEY=
JLCPCB_SECRET_KEY=
JLCPCB_TOKENIZATION_PUBLIC_KEY=
JLCPCB_TOKENIZATION_PRIVATE_KEY=

# Keep false until JLCPCB approves and RoarCAD verifies the account-specific quote contract.
JLCPCB_QUOTE_ENABLED=false
# Server-only MacroFab credential. Never expose this through a VITE_ variable.
MACROFAB_API_KEY=
