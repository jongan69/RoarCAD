      "design": "<supplied-BoardGraph>"
    }
  },
  {
    "id": "preview-change",
    "prompt": "Preview moving D1 to x 3 mm and y 2 mm without modifying the stored revision.",
    "expectedTool": "preview_design_change",
    "expectedArguments": {
