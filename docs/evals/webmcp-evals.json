      "request": "Move D1 to x 3 mm and y 2 mm",
      "operations": [
        {
          "type": "move-component",
          "reference": "D1",
          "x": 3,
          "y": 2,
          "rotation": 0,
          "side": "top"
        }
      ]
    }
  },
  {
