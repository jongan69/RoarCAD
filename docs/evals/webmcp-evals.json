      "focus": "components",
      "cursor": 2
    }
  },
  {
    "id": "draft-board",
    "prompt": "Draft this supplied structured BoardGraph and keep all agent-supplied review claims untrusted.",
    "expectedTool": "draft_board",
    "expectedArguments": {
